<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sparkle update feed for the Fire maintained fork of Ice.

	  Feed XML is served from a separate dedicated repository
	  (pdurlej/fire-releases) via GitHub Pages so that the source
	  repository (pdurlej/Ice) does not need to host static XML on a
	  branch. Each tagged release on this repository is signed with the
	  matching EdDSA private key — kept exclusively in the maintainer's
	  Keychain and in the SPARKLE_PRIVATE_KEY GitHub Actions secret —
	  and an <item> entry is appended to the feed.

	  Replacing either of these values silently routes users to the
	  wrong update feed or breaks signature verification on every
	  install. Treat as load-bearing.
	-->
	<key>SUFeedURL</key>
	<string>https://pdurlej.github.io/fire-releases/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>JQ+doXtLQyWmGDao7dTzF4dNgnkSmAWmN66Ee/lw9Yc=</string>

	<!--
	  In-process Mach service hosted by Ice main app for the MCP backend
	  (com.jordanbaird.Ice.MCPBackend). Lets the IceMCPBridge binary
	  connect via XPCSession to a listener that runs INSIDE Ice's
	  process - so MenuBarItemManager.itemCache is populated and write
	  operations (move/hide/show/applyLayout) can use the real AX drag
	  path that the Layout settings UI uses.

	  This is distinct from MenuBarItemService.xpc (the embedded XPC
	  service bundle which still serves legacy sourcePID lookups for
	  Ice main app itself). Bridge fire.7+ targets MCPBackend; fire.6
	  targeted MenuBarItemService.
	-->
	<key>MachServices</key>
	<dict>
		<key>com.jordanbaird.Ice.MCPBackend</key>
		<true/>
	</dict>
</dict>
</plist>
