// MCPBridge/main.swift
//
// Entry point for IceMCPBridge — a Model Context Protocol (MCP) server that
// bridges LLM clients (via stdio) to Ice’s MenuBarItemService XPC service.
// Part of Phase 4.5: MCP server MVP with 6 tools.
//
// The server registers tools for listing, moving, hiding/showing items,
// and saving/applying layouts. Each tool handler validates input, sends
// a corresponding XPC request, and maps the response back to an MCP result.
//
// TODO: Verify MCP SDK API surface (MCPServer, MCPTool, MCPToolCall, etc.)
//       and adjust if needed. The current code assumes an async handler
//       that receives decoded arguments and returns a result with text content.

import Foundation
import MCP
import os

// MARK: - Logging

extension Logger {
    private static let subsystem = "com.jordanbaird.Ice.MCPBridge"

    static let server = Logger(subsystem: subsystem, category: "server")
    static let tools = Logger(subsystem: subsystem, category: "tools")
    static let xpc = Logger(subsystem: subsystem, category: "xpc")
}

// MARK: - XPC Contract (mirrors MenuBarItemService)

/// Protocol that the XPC service exposes.
@objc protocol MenuBarItemServiceProtocol {
    func performRequest(_ requestData: Data, reply: @escaping (Data?, Error?) -> Void)
}

/// XPC client that connects to com.jordanbaird.Ice.MenuBarItemService.
final class MenuBarItemServiceXPCClient {
    private let connection: NSXPCConnection
    private let logger = Logger.xpc

    init() {
        connection = NSXPCConnection(serviceName: "com.jordanbaird.Ice.MenuBarItemService")
        connection.remoteObjectInterface = NSXPCInterface(with: MenuBarItemServiceProtocol.self)
        connection.resume()
        logger.info("XPC connection established")
    }

    deinit {
        connection.invalidate()
        logger.info("XPC connection invalidated")
    }

    /// Sends a request and returns the decoded response.
    func sendRequest(_ request: MenuBarItemService.Request) async throws -> MenuBarItemService.Response {
        let requestData = try JSONEncoder().encode(request)
        logger.debug("Sending XPC request: \(String(describing: request))")

        return try await withCheckedThrowingContinuation { continuation in
            let proxy = connection.remoteObjectProxyWithErrorHandler { error in
                self.logger.error("XPC proxy error: \(error.localizedDescription)")
                continuation.resume(throwing: error)
            } as! MenuBarItemServiceProtocol

            proxy.performRequest(requestData) { responseData, error in
                if let error = error {
                    self.logger.error("XPC call failed: \(error.localizedDescription)")
                    continuation.resume(throwing: error)
                    return
                }
                guard let responseData = responseData else {
                    self.logger.error("XPC response data is nil")
                    continuation.resume(throwing: MCPBridgeError.xpcResponseMissing)
                    return
                }
                do {
                    let response = try JSONDecoder().decode(MenuBarItemService.Response.self, from: responseData)
                    self.logger.debug("Received XPC response: \(String(describing: response))")
                    continuation.resume(returning: response)
                } catch {
                    self.logger.error("Failed to decode XPC response: \(error.localizedDescription)")
                    continuation.resume(throwing: error)
                }
            }
        }
    }
}

// MARK: - Errors

enum MCPBridgeError: LocalizedError {
    case xpcResponseMissing
    case invalidArguments(String)
    case toolExecutionFailed(String)

    var errorDescription: String? {
        switch self {
        case .xpcResponseMissing: return "XPC response missing"
        case .invalidArguments(let detail): return "Invalid arguments: \(detail)"
        case .toolExecutionFailed(let detail): return "Tool execution failed: \(detail)"
        }
    }
}

// MARK: - Tool Argument Types

struct ListItemsArgs: Codable {
    let section: String?  // "alwaysVisible", "hidden", "alwaysHidden"
}

struct MoveItemArgs: Codable {
    let bundleID: String
    let toSection: String
    let toIndex: Int?
}

struct HideShowArgs: Codable {
    let bundleID: String
}

struct LayoutNameArgs: Codable {
    let name: String
}

// MARK: - MCP Server Entry Point

@main
struct IceMCPBridge {
    static func main() async throws {
        let logger = Logger.server
        logger.info("Starting IceMCPBridge MCP server")

        // 1. Create the MCP server instance
        // TODO: Verify MCPServer initializer signature.
        let server = MCPServer(name: "IceMCPBridge", version: "0.1.0")

        // 2. Create the XPC client (shared across all tools)
        let xpcClient = MenuBarItemServiceXPCClient()

        // 3. Register all 6 tools
        registerListItems(server: server, xpcClient: xpcClient)
        registerMoveItem(server: server, xpcClient: xpcClient)
        registerHideItem(server: server, xpcClient: xpcClient)
        registerShowItem(server: server, xpcClient: xpcClient)
        registerApplyLayout(server: server, xpcClient: xpcClient)
        registerSaveLayout(server: server, xpcClient: xpcClient)

        // 4. Start the server on stdio transport
        // TODO: Verify transport enum and start method.
        try await server.start(transport: .stdio)
        logger.info("MCP server stopped")
    }

    // MARK: - Tool Registration Helpers

    /// Registers the `list_items` tool (readOnly).
    private static func registerListItems(server: MCPServer, xpcClient: MenuBarItemServiceXPCClient) {
        let inputSchema = """
        {
          "type": "object",
          "properties": {
            "section": {
              "type": "string",
              "enum": ["alwaysVisible", "hidden", "alwaysHidden"]
            }
          }
        }
        """

        // TODO: Verify MCPTool initializer and handler signature.
        let tool = MCPTool(
            name: "list_items",
            description: "Returns all menu bar items with metadata, optionally filtered by section.",
            inputSchema: inputSchema,
            annotations: ["readOnly": "true"]
        ) { call in
            let logger = Logger.tools
            logger.debug("Handling list_items with arguments: \(call.arguments)")

            // Decode arguments
            let args: ListItemsArgs
            do {
                let data = try JSONSerialization.data(withJSONObject: call.arguments, options: [])
                args = try JSONDecoder().decode(ListItemsArgs.self, from: data)
            } catch {
                throw MCPBridgeError.invalidArguments("Failed to parse arguments: \(error.localizedDescription)")
            }

            // Map section string to ItemSection if provided
            let section: MenuBarItemService.ItemSection?
            if let sectionStr = args.section {
                guard let sec = MenuBarItemService.ItemSection(rawValue: sectionStr) else {
                    throw MCPBridgeError.invalidArguments("Invalid section: \(sectionStr)")
                }
                section = sec
            } else {
                section = nil
            }

            // Send XPC request
            let response = try await xpcClient.sendRequest(.listItems(section: section))

            // Map response to JSON result
            switch response {
            case .items(let items):
                let jsonData = try JSONEncoder().encode(items)
                let jsonString = String(data: jsonData, encoding: .utf8) ?? "[]"
                return MCPToolResult(content: [.text(jsonString)])
            default:
                throw MCPBridgeError.toolExecutionFailed("Unexpected XPC response: \(response)")
            }
        }
        server.registerTool(tool)
    }

    /// Registers the `move_item` tool (destructive, idempotent).
    private static func registerMoveItem(server: MCPServer, xpcClient: MenuBarItemServiceXPCClient) {
        let inputSchema = """
        {
          "type": "object",
          "properties": {
            "bundleID": { "type": "string" },
            "toSection": { "type": "string", "enum": ["alwaysVisible", "hidden", "alwaysHidden"] },
            "toIndex": { "type": "integer", "minimum": 0 }
          },
          "required": ["bundleID", "toSection"]
        }
        """

        let tool = MCPTool(
            name: "move_item",
            description: "Move a menu bar item to a different section and optional index.",
            inputSchema: inputSchema,
            annotations: ["destructive": "true", "idempotent": "true"]
        ) { call in
            let logger = Logger.tools
            logger.debug("Handling move_item with arguments: \(call.arguments)")

            let args: MoveItemArgs
            do {
                let data = try JSONSerialization.data(withJSONObject: call.arguments, options: [])
                args = try JSONDecoder().decode(MoveItemArgs.self, from: data)
            } catch {
                throw MCPBridgeError.invalidArguments("Failed to parse arguments: \(error.localizedDescription)")
            }

            guard let section = MenuBarItemService.ItemSection(rawValue: args.toSection) else {
                throw MCPBridgeError.invalidArguments("Invalid toSection: \(args.toSection)")
            }

            let response = try await xpcClient.sendRequest(
                .moveItem(bundleID: args.bundleID, toSection: section, toIndex: args.toIndex)
            )

            return try encodeMutationResult(response)
        }
        server.registerTool(tool)
    }

    /// Registers the `hide_item` tool (destructive, idempotent).
    private static func registerHideItem(server: MCPServer, xpcClient: MenuBarItemServiceXPCClient) {
        let inputSchema = """
        {
          "type": "object",
          "properties": { "bundleID": { "type": "string" } },
          "required": ["bundleID"]
        }
        """

        let tool = MCPTool(
            name: "hide_item",
            description: "Hide a menu bar item (move to hidden section).",
            inputSchema: inputSchema,
            annotations: ["destructive": "true", "idempotent": "true"]
        ) { call in
            let args: HideShowArgs = try decodeArguments(call.arguments)
            let response = try await xpcClient.sendRequest(.hideItem(bundleID: args.bundleID))
            return try encodeMutationResult(response)
        }
        server.registerTool(tool)
    }

    /// Registers the `show_item` tool (destructive, idempotent).
    private static func registerShowItem(server: MCPServer, xpcClient: MenuBarItemServiceXPCClient) {
        let inputSchema = """
        {
          "type": "object",
          "properties": { "bundleID": { "type": "string" } },
          "required": ["bundleID"]
        }
        """

        let tool = MCPTool(
            name: "show_item",
            description: "Show a menu bar item (move to always visible section).",
            inputSchema: inputSchema,
            annotations: ["destructive": "true", "idempotent": "true"]
        ) { call in
            let args: HideShowArgs = try decodeArguments(call.arguments)
            let response = try await xpcClient.sendRequest(.showItem(bundleID: args.bundleID))
            return try encodeMutationResult(response)
        }
        server.registerTool(tool)
    }

    /// Registers the `apply_layout` tool (destructive).
    private static func registerApplyLayout(server: MCPServer, xpcClient: MenuBarItemServiceXPCClient) {
        let inputSchema = """
        {
          "type": "object",
          "properties": { "name": { "type": "string" } },
          "required": ["name"]
        }
        """

        let tool = MCPTool(
            name: "apply_layout",
            description: "Apply a saved layout by name.",
            inputSchema: inputSchema,
            annotations: ["destructive": "true"]
        ) { call in
            let args: LayoutNameArgs = try decodeArguments(call.arguments)
            let response = try await xpcClient.sendRequest(.applyLayout(name: args.name))
            return try encodeMutationResult(response)
        }
        server.registerTool(tool)
    }

    /// Registers the `save_layout` tool (readOnly + writes-to-storage).
    private static func registerSaveLayout(server: MCPServer, xpcClient: MenuBarItemServiceXPCClient) {
        let inputSchema = """
        {
          "type": "object",
          "properties": { "name": { "type": "string" } },
          "required": ["name"]
        }
        """

        let tool = MCPTool(
            name: "save_layout",
            description: "Save the current menu bar state as a named layout.",
            inputSchema: inputSchema,
            annotations: ["readOnly": "true", "writes-to-storage": "true"]
        ) { call in
            let args: LayoutNameArgs = try decodeArguments(call.arguments)
            let response = try await xpcClient.sendRequest(.saveLayout(name: args.name))

            switch response {
            case .layoutSaved(let name, let itemCount):
                let result = ["name": name, "itemCount": itemCount] as [String: Any]
                let jsonData = try JSONSerialization.data(withJSONObject: result, options: [])
                let jsonString = String(data: jsonData, encoding: .utf8) ?? "{}"
                return MCPToolResult(content: [.text(jsonString)])
            default:
                throw MCPBridgeError.toolExecutionFailed("Unexpected XPC response: \(response)")
            }
        }
        server.registerTool(tool)
    }

    // MARK: - Helpers

    /// Decodes tool call arguments into a Decodable type.
    private static func decodeArguments<T: Decodable>(_ arguments: [String: Any]) throws -> T {
        let data = try JSONSerialization.data(withJSONObject: arguments, options: [])
        return try JSONDecoder().decode(T.self, from: data)
    }

    /// Encodes a mutation result (success, undoToken, message) into an MCP text result.
    private static func encodeMutationResult(_ response: MenuBarItemService.Response) throws -> MCPToolResult {
        switch response {
        case .mutationResult(let success, let undoToken, let message):
            let result: [String: Any?] = [
                "success": success,
                "undoToken": undoToken,
                "message": message
            ]
            let jsonData = try JSONSerialization.data(withJSONObject: result, options: [])
            let jsonString = String(data: jsonData, encoding: .utf8) ?? "{}"
            return MCPToolResult(content: [.text(jsonString)])
        default:
            throw MCPBridgeError.toolExecutionFailed("Expected mutationResult, got \(response)")
        }
    }
}